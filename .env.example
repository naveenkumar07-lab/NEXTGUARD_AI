# NetGuard AI Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=netguard_ai_secure_production_secret_key_change_me
DATABASE_URL=sqlite:///instance/netguard.db

# Default Admin Credentials (Auto-created on first run if not present)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@netguard.local

# Monitoring Defaults
DEFAULT_MONITOR_INTERVAL=2.0
DOWNLOAD_ALERT_THRESHOLD_MBPS=100.0
UPLOAD_ALERT_THRESHOLD_MBPS=50.0
PACKET_RATE_THRESHOLD_PPS=5000

# Demonstration Mode (Set 1 to start in demo mode, 0 for real interface mode)
START_IN_DEMO_MODE=1
DEFAULT_DEMO_SCENARIO=NORMAL
